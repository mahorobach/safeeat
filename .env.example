# ===== SafeEat 環境変数テンプレート =====
# Railway のダッシュボード（Variables タブ）に以下を設定してください
# このファイルは .gitignore に含まれています（コピーして .env を作成）

# --- Supabase ---
# Supabase ダッシュボード > Settings > API で確認
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Stripe ダッシュボード > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe ダッシュボード > Developers > Webhooks > エンドポイントの署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_...

# --- アプリ設定 ---
# SafeEat 管理者メールアドレス（成分の verify 権限）
ADMIN_EMAIL=your@email.com

# CORS 許可オリジン（カンマ区切り）
# 本番: https://yourdomain.com,https://www.yourdomain.com
# 開発: http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Railway が自動で設定する（手動設定不要）
# PORT=3000
