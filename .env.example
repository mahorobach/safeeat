# ===== SafeEat 環境変数テンプレート =====
# Render のダッシュボード（Environment タブ）に以下を設定してください
# このファイルは .gitignore に含まれています（コピーして .env を作成）
# ローカル: 必ず server/.env に置く（server/index.js が server フォルダ内の .env を読み込みます）

# --- Claude API ---
# Anthropic コンソール > API Keys で取得
CLAUDE_API_KEY=sk-ant-api03-...
# テキスト判定モデル（省略時 claude-sonnet-4-20250514）
# CLAUDE_MODEL=claude-sonnet-4-20250514
# 写真（Vision）1往復のみ変更したいとき（処理が速く、タイムアウトしにくい例）
# CLAUDE_IMAGE_MODEL=claude-3-5-haiku-20241022

# --- Supabase ---
# Supabase ダッシュボード > Settings > API で確認
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Stripe ダッシュボード > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe ダッシュボード > Developers > Webhooks > エンドポイントの署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_...

# --- アプリ設定 ---
# SafeEat 管理者メールアドレス（成分の verify 権限）
ADMIN_EMAIL=your@email.com

# CORS 許可オリジン（カンマ区切り）
# 本番: https://yourdomain.com,https://www.yourdomain.com
# 開発（どちらで開くか分かれるため両方入れる）:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Render が自動で設定する（手動設定不要）
# PORT=10000
