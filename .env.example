# ===== SafeEat 環境変数テンプレート =====
# Render のダッシュボード（Environment タブ）に以下を設定してください
# このファイルは .gitignore に含まれています（コピーして .env を作成）
# ローカル: 必ず server/.env に置く（server/index.js が server フォルダ内の .env を読み込みます）

# --- Claude API ---
# Anthropic コンソール > API Keys で取得
CLAUDE_API_KEY=sk-ant-api03-...

# --- Gemini API（試験中・オプション）---
# Google AI Studio (https://aistudio.google.com) > Get API key
# 未設定の場合、Gemini エンジン選択時に 500 エラーになります
GEMINI_API_KEY=AIza...
# Gemini モデル名（省略時: gemini-1.5-flash-latest）
# 例: gemini-1.5-pro-latest / gemini-2.0-flash / gemini-2.0-flash-exp
# GEMINI_MODEL=gemini-1.5-flash-latest
# テキスト判定モデル（省略時 claude-sonnet-4-20250514）
# CLAUDE_MODEL=claude-sonnet-4-20250514
# 写真読み取り extractOnly は CLAUDE_IMAGE_EXTRACT_MODEL（省略時 CLAUDE_MODEL）
# 例: claude-haiku-4-5（高速） ※ claude-3-5-haiku-20241022 は廃止のため使わない
# CLAUDE_IMAGE_EXTRACT_MODEL=claude-haiku-4-5
# API の temperature（省略時 0。テキスト判定に使用。extractOnly には未使用）
# CLAUDE_TEMPERATURE=0

# --- Supabase ---
# Supabase ダッシュボード > Settings > API で確認
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Stripe ダッシュボード > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe ダッシュボード > Developers > Webhooks > エンドポイントの署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_...

# --- アプリ設定 ---
# SafeEat 管理者メールアドレス（成分の verify 権限）
ADMIN_EMAIL=your@email.com

# CORS 許可オリジン（カンマ区切り）
# 本番: https://yourdomain.com,https://www.yourdomain.com
# 開発（どちらで開くか分かれるため両方入れる）:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Render が自動で設定する（手動設定不要）
# PORT=10000
